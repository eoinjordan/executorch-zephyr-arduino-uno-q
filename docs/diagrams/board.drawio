46E;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="36" y="460" width="63.2653" height="2" as="geometry"/></mxCell><mxCell id="c155" value="10 mm   (68.6 x 53.3 mm)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#60646E;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="105.265" y="448" width="200" height="24" as="geometry"/></mxCell><mxCell id="c156" value="&lt;font style=&quot;font-size: 30px&quot;&gt;&lt;b&gt;Arduino UNO Q&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 15px&quot; color=&quot;#60646E&quot;&gt;Arduino&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;ul style=&quot;margin: 0 0 0 18px; padding: 0&quot;&gt;&lt;li&gt;STM32U585 (Arm Cortex-M33, 160 MHz) runs Zephyr + ExecuTorch&lt;/li&gt;&lt;li&gt;Qualcomm QRB2210 (quad A53, Debian) is the Linux side&lt;/li&gt;&lt;li&gt;786 KB SRAM, 2 MB flash on the STM32&lt;/li&gt;&lt;li&gt;Flash: OpenOCD through the Linux side (adb + arduino-debug)&lt;/li&gt;&lt;li&gt;Console: LPUART1, /dev/ttyHS1 on the Linux side&lt;/li&gt;&lt;li&gt;This repo: AnomalyNet, verdicts as JSON + the 13x8 LED matrix&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="520" y="30" width="650" height="400" as="geometry"/></mxCell><mxCell id="c157" value="Silhouette drawn to scale from the board's dimensions; not a photo. Edit this file in draw.io." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#60646E;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="520" y="470" width="650" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>